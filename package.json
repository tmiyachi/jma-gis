{
  "name": "jma-gis",
  "version": "1.0.3",
  "description": "Sample page using vector tiles processed from JMA GIS shape file",
  "main": "index.js",
  "dependencies": {
    "maplibre-gl": "^5.2.0",
    "mapshaper": "^0.6.113",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "eslint-cli": "^1.1.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.8",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "sass": "^1.85.1",
    "sass-loader": "^16.0.7",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "vite": "^8.0.3"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.mjs",
    "start": "vite dev --config web/vite.config.mjs",
    "lint:eslint": "eslint web/src/**/*.js --config web/eslint.config.mjs",
    "lint:stylelint": "stylelint web/src/**/*.css --config web/stylelint.config.mjs",
    "lint:prettier": "prettier web/src/**/*.{js,css} --check --config web/prettier.config.mjs",
    "lint": "run-p lint:*",
    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:stylelint": "npm run lint:stylelint -- --fix",
    "fix:prettier": "npm run lint:prettier -- --write",
    "fix": "run-s fix:*"
  },
  "private": true,
  "keywords": [],
  "author": "tmiyachi",
  "license": "MIT"
}
